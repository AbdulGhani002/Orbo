<%- include('../shared/head') %>
<title>Orbo - Buy anything you want!</title>
</head>
<body>
  <%- include('../shared/navigation') %>

  <section id="body">
    <h1 id="heading">Welcome to Orbo Store!</h1>

    <section id="products">
      <% if (products.length > 0) { %>
        <% products.forEach(product => { %>
          <div class="product">
            <img src="/data/<%=product.imageUrl%>" alt="<%= product.name %>">
            <h2><%= product.name %></h2>
            <p>$<%= product.price.toFixed(2) %></p>
          </div>
        <% }); %>
      <% } else { %>
        <p>No products available.</p>
      <% } %>
    </section>

  </section>
</body>
</html>
