<%- include('../shared/head') %>
<link rel="stylesheet" href="/styles/all-users-page.css">
<title>Orbo - View All Users</title>
</head>
<body>
<%- include('../shared/navigation') %>
<section id="body">
<h1 id="heading">All Users</h1>
<table border="1">
    <thead>
      <tr>
        <th>Name</th>
        <th>Phone</th>
        <th>City</th>
        <th>Street</th>
        <th>Country</th>
        <th>Postal Code</th>
        <th>Email</th>
        <th>Admin</th>
        <th>Actions</th>
      </tr>
    </thead>
    <tbody>
      <% users.forEach((user) => { %>
        <tr>
          <td><%= user.name %></td>
          <td><%= user.phone %></td>
          <td><%= user.city %></td>
          <td><%= user.street %></td>
          <td><%= user.country %></td>
          <td><%= user.postalCode %></td>
          <td><%= user.email %></td>
          <td><%= user.isAdmin ? 'Yes' : 'No' %></td>
          <td>

            <% if (!user.isAdmin) { %>
              <form action="/admin/restrict/<%= user._id %>" method="POST" style="display:inline;">
                <button type="submit">Restrict Permissions</button>
              </form>
            <% } else { %>
              <span>Admin</span>
            <% } %>
            

            <a href="/admin/edit/<%= user._id %>">Edit</a>
            <form action="/admin/delete/<%= user._id %>" method="POST" style="display:inline;">
              <button type="submit" onclick="return confirm('Are you sure you want to delete this user?')">Delete</button>
            </form>
          </td>
        </tr>
      <% }); %>
    </tbody>
  </table>
</section>
<%- include('./admin_includes/footer') %>
